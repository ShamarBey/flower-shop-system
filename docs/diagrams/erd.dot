digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.6", ranksep="1.3", splines=polyline, fontname="Arial", label="Цветочный магазин — ERD из erd.dbml\nPK — первичный ключ; FK — внешний ключ; UQ — уникальность; NN — NOT NULL\n1 / 0..1 / 0..* — кратность на соответствующем конце связи", labelloc=t, fontsize=20];
node [shape=plain, fontname="Arial"];
edge [color="#64748b", fontname="Arial", fontsize=10, dir=none, labeldistance=2.5];
"users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>users</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="email" ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_email" ALIGN="LEFT">UQ NN</TD></TR><TR><TD PORT="password_hash" ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_password_hash" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="full_name" ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_full_name" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD PORT="out_is_active" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_created_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>roles</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">smallint</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(40)</TD><TD PORT="out_code" ALIGN="LEFT">UQ NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD PORT="out_name" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"user_roles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>user_roles</B></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_user_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="role_id" ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">smallint</TD><TD PORT="out_role_id" ALIGN="LEFT">PK FK NN</TD></TR></TABLE>>];
"customer_profiles" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>customer_profiles</B></TD></TR><TR><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_user_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="phone" ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">varchar(30)</TD><TD PORT="out_phone" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="default_address" ALIGN="LEFT">default_address</TD><TD ALIGN="LEFT">text</TD><TD PORT="out_default_address" ALIGN="LEFT"></TD></TR></TABLE>>];
"categories" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>categories</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD PORT="out_name" ALIGN="LEFT">UQ NN</TD></TR></TABLE>>];
"products" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>products</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="category_id" ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_category_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="sku" ALIGN="LEFT">sku</TD><TD ALIGN="LEFT">varchar(64)</TD><TD PORT="out_sku" ALIGN="LEFT">UQ NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_name" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="product_type" ALIGN="LEFT">product_type</TD><TD ALIGN="LEFT">product_type</TD><TD PORT="out_product_type" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="unit" ALIGN="LEFT">unit</TD><TD ALIGN="LEFT">varchar(20)</TD><TD PORT="out_unit" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="price" ALIGN="LEFT">price</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD PORT="out_price" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="min_quantity" ALIGN="LEFT">min_quantity</TD><TD ALIGN="LEFT">numeric(10,3)</TD><TD PORT="out_min_quantity" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="max_quantity" ALIGN="LEFT">max_quantity</TD><TD ALIGN="LEFT">numeric(10,3)</TD><TD PORT="out_max_quantity" ALIGN="LEFT"></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD PORT="out_is_active" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"warehouses" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>warehouses</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(150)</TD><TD PORT="out_name" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="address" ALIGN="LEFT">address</TD><TD ALIGN="LEFT">text</TD><TD PORT="out_address" ALIGN="LEFT"></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD PORT="out_is_active" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"stock_balances" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>stock_balances</B></TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_warehouse_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="on_hand" ALIGN="LEFT">on_hand</TD><TD ALIGN="LEFT">numeric(12,3)</TD><TD PORT="out_on_hand" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="reserved" ALIGN="LEFT">reserved</TD><TD ALIGN="LEFT">numeric(12,3)</TD><TD PORT="out_reserved" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_updated_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"stock_movements" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>stock_movements</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_warehouse_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="movement_type" ALIGN="LEFT">movement_type</TD><TD ALIGN="LEFT">movement_type</TD><TD PORT="out_movement_type" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">numeric(12,3)</TD><TD PORT="out_quantity" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="reason" ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_reason" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_order_id" ALIGN="LEFT">FK</TD></TR><TR><TD PORT="created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_created_by" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_created_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"bouquet_recipes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>bouquet_recipes</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_name" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD PORT="out_description" ALIGN="LEFT"></TD></TR><TR><TD PORT="is_active" ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD><TD PORT="out_is_active" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"recipe_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>recipe_items</B></TD></TR><TR><TD PORT="recipe_id" ALIGN="LEFT">recipe_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_recipe_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">PK FK NN</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">numeric(10,3)</TD><TD PORT="out_quantity" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="is_required" ALIGN="LEFT">is_required</TD><TD ALIGN="LEFT">boolean</TD><TD PORT="out_is_required" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"bouquet_drafts" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>bouquet_drafts</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="customer_id" ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_customer_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_name" ALIGN="LEFT"></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_created_at" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="updated_at" ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_updated_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"bouquet_draft_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>bouquet_draft_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="draft_id" ALIGN="LEFT">draft_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_draft_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">numeric(10,3)</TD><TD PORT="out_quantity" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"orders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>orders</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="number" ALIGN="LEFT">number</TD><TD ALIGN="LEFT">varchar(32)</TD><TD PORT="out_number" ALIGN="LEFT">UQ NN</TD></TR><TR><TD PORT="customer_id" ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_customer_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">order_status</TD><TD PORT="out_status" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="fulfillment_type" ALIGN="LEFT">fulfillment_type</TD><TD ALIGN="LEFT">varchar(20)</TD><TD PORT="out_fulfillment_type" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="delivery_address" ALIGN="LEFT">delivery_address</TD><TD ALIGN="LEFT">text</TD><TD PORT="out_delivery_address" ALIGN="LEFT"></TD></TR><TR><TD PORT="scheduled_at" ALIGN="LEFT">scheduled_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_scheduled_at" ALIGN="LEFT"></TD></TR><TR><TD PORT="delivery_fee" ALIGN="LEFT">delivery_fee</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD PORT="out_delivery_fee" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_created_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"order_items" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>order_items</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_order_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="product_name_snapshot" ALIGN="LEFT">product_name_snapshot</TD><TD ALIGN="LEFT">varchar(255)</TD><TD PORT="out_product_name_snapshot" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="unit_price_snapshot" ALIGN="LEFT">unit_price_snapshot</TD><TD ALIGN="LEFT">numeric(12,2)</TD><TD PORT="out_unit_price_snapshot" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">numeric(10,3)</TD><TD PORT="out_quantity" ALIGN="LEFT">NN</TD></TR></TABLE>>];
"reservations" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>reservations</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_order_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="warehouse_id" ALIGN="LEFT">warehouse_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_warehouse_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="product_id" ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_product_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="quantity" ALIGN="LEFT">quantity</TD><TD ALIGN="LEFT">numeric(12,3)</TD><TD PORT="out_quantity" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="expires_at" ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_expires_at" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="released_at" ALIGN="LEFT">released_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_released_at" ALIGN="LEFT"></TD></TR></TABLE>>];
"order_status_history" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>order_status_history</B></TD></TR><TR><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_id" ALIGN="LEFT">PK NN</TD></TR><TR><TD PORT="order_id" ALIGN="LEFT">order_id</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_order_id" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="from_status" ALIGN="LEFT">from_status</TD><TD ALIGN="LEFT">order_status</TD><TD PORT="out_from_status" ALIGN="LEFT"></TD></TR><TR><TD PORT="to_status" ALIGN="LEFT">to_status</TD><TD ALIGN="LEFT">order_status</TD><TD PORT="out_to_status" ALIGN="LEFT">NN</TD></TR><TR><TD PORT="changed_by" ALIGN="LEFT">changed_by</TD><TD ALIGN="LEFT">uuid</TD><TD PORT="out_changed_by" ALIGN="LEFT">FK NN</TD></TR><TR><TD PORT="comment" ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">text</TD><TD PORT="out_comment" ALIGN="LEFT"></TD></TR><TR><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD PORT="out_created_at" ALIGN="LEFT">NN</TD></TR></TABLE>>];
