Enum product_type {
  FLOWER
  PACKAGING
  DECOR
  SERVICE
}

Enum order_status {
  NEW
  CONFIRMED
  NEEDS_APPROVAL
  ASSEMBLING
  READY
  COMPLETED
  CANCELLED
}

Enum movement_type {
  RECEIPT
  RESERVATION
  RELEASE
  WRITE_OFF
  SALE
  ADJUSTMENT
  TRANSFER
}

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
}

Table roles {
  id smallint [pk]
  code varchar(40) [not null, unique]
  name varchar(100) [not null]
}

Table user_roles {
  user_id uuid [pk, ref: > users.id]
  role_id smallint [pk, ref: > roles.id]

  indexes {
    role_id [name: 'idx_user_roles_role']
  }
}

Table customer_profiles {
  user_id uuid [pk, ref: - users.id]
  phone varchar(30) [not null]
  default_address text
}

Table categories {
  id uuid [pk]
  name varchar(100) [not null, unique]
}

Table products {
  id uuid [pk]
  category_id uuid [not null, ref: > categories.id]
  sku varchar(64) [not null, unique]
  name varchar(255) [not null]
  product_type product_type [not null]
  unit varchar(20) [not null]
  price numeric(12,2) [not null]
  min_quantity numeric(10,3) [not null, default: 1]
  max_quantity numeric(10,3)
  is_active boolean [not null, default: true]

  indexes {
    category_id [name: 'idx_products_category']
    is_active [name: 'idx_products_active']
  }

  checks {
    `price >= 0`
    `min_quantity > 0`
    `max_quantity IS NULL OR max_quantity >= min_quantity`
  }
}

Table warehouses {
  id uuid [pk]
  name varchar(150) [not null]
  address text
  is_active boolean [not null, default: true]
}

Table stock_balances {
  warehouse_id uuid [pk, ref: > warehouses.id]
  product_id uuid [pk, ref: > products.id]
  on_hand numeric(12,3) [not null, default: 0]
  reserved numeric(12,3) [not null, default: 0]
  updated_at timestamptz [not null]

  indexes {
    product_id [name: 'idx_stock_balances_product']
  }

  checks {
    `on_hand >= 0`
    `reserved >= 0`
    `reserved <= on_hand`
  }
}

Table stock_movements {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  product_id uuid [not null, ref: > products.id]
  movement_type movement_type [not null]
  quantity numeric(12,3) [not null]
  reason varchar(255) [not null]
  order_id uuid [ref: > orders.id]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]

  indexes {
    (warehouse_id, product_id) [name: 'idx_movements_stock']
    product_id [name: 'idx_movements_product']
    order_id [name: 'idx_movements_order']
    created_by [name: 'idx_movements_author']
  }

  checks {
    `quantity > 0`
  }
}

Table bouquet_recipes {
  id uuid [pk]
  name varchar(255) [not null]
  description text
  is_active boolean [not null, default: true]
}

Table recipe_items {
  recipe_id uuid [pk, ref: > bouquet_recipes.id]
  product_id uuid [pk, ref: > products.id]
  quantity numeric(10,3) [not null]
  is_required boolean [not null, default: false]

  indexes {
    product_id [name: 'idx_recipe_items_product']
  }

  checks {
    `quantity > 0`
  }
}

Table bouquet_drafts {
  id uuid [pk]
  customer_id uuid [not null, ref: > users.id]
  name varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    customer_id [name: 'idx_drafts_customer']
  }
}

Table bouquet_draft_items {
  id uuid [pk]
  draft_id uuid [not null, ref: > bouquet_drafts.id]
  product_id uuid [not null, ref: > products.id]
  quantity numeric(10,3) [not null]

  indexes {
    (draft_id, product_id) [unique, name: 'uq_draft_product']
    product_id [name: 'idx_draft_items_product']
  }

  checks {
    `quantity > 0`
  }
}

Table orders {
  id uuid [pk]
  number varchar(32) [not null, unique]
  customer_id uuid [not null, ref: > users.id]
  status order_status [not null]
  fulfillment_type varchar(20) [not null]
  delivery_address text
  scheduled_at timestamptz
  delivery_fee numeric(12,2) [not null, default: 0]
  created_at timestamptz [not null]

  indexes {
    customer_id [name: 'idx_orders_customer']
    status [name: 'idx_orders_status']
    created_at [name: 'idx_orders_created_at']
  }

  checks {
    `delivery_fee >= 0`
    `fulfillment_type IN ('DELIVERY', 'PICKUP')`
    `fulfillment_type <> 'DELIVERY' OR (delivery_address IS NOT NULL AND length(trim(delivery_address)) > 0)`
  }
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  product_id uuid [not null, ref: > products.id]
  product_name_snapshot varchar(255) [not null]
  unit_price_snapshot numeric(12,2) [not null]
  quantity numeric(10,3) [not null]

  indexes {
    order_id [name: 'idx_order_items_order']
    product_id [name: 'idx_order_items_product']
  }

  checks {
    `quantity > 0`
    `unit_price_snapshot >= 0`
  }
}

Table reservations {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  warehouse_id uuid [not null, ref: > warehouses.id]
  product_id uuid [not null, ref: > products.id]
  quantity numeric(12,3) [not null]
  expires_at timestamptz [not null]
  released_at timestamptz

  indexes {
    order_id [name: 'idx_reservations_order']
    expires_at [name: 'idx_reservations_expires']
    warehouse_id [name: 'idx_reservations_warehouse']
    product_id [name: 'idx_reservations_product']
  }

  checks {
    `quantity > 0`
  }
}

Table order_status_history {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  from_status order_status
  to_status order_status [not null]
  changed_by uuid [not null, ref: > users.id]
  comment text
  created_at timestamptz [not null]

  indexes {
    order_id [name: 'idx_status_history_order']
    changed_by [name: 'idx_status_history_author']
  }
}
